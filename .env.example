# Required for YouTube video metadata and duration validation
YOUTUBE_API_KEY=

# Optional opt-in video URL analysis provider. No paid fallback is ever used automatically.
# Verify applicable free tier, policies, and quota for your project before enabling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only set to a verified free alternative that accepts YouTube URLs:
GEMINI_FALLBACK_MODEL=

# Required fail-closed quota store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required: set a long random value for IP abuse throttling hash
QUOTA_HASH_SECRET=
IP_HOURLY_REQUESTS=12

# Service hard limits; count is per calendar day Asia/Seoul
GLOBAL_DAILY_ANALYSES=12
# Worst case is reserved for up to two AI attempts per video.
GLOBAL_DAILY_VIDEO_SECONDS=21600
# Emergency kill switch (existing browser history remains available)
ANALYSIS_PAUSED=false

# Optional estimate rates, in USD per 1 million tokens (not actual invoices)
AI_INPUT_USD_PER_1M_TOKENS=
AI_OUTPUT_USD_PER_1M_TOKENS=
