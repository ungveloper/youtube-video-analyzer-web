# Google Cloud / YouTube Data API v3: free daily quota applies.
YOUTUBE_API_KEY=

# Google AI Studio: use an API key from a project that has NO billing enabled.
# The server cannot automatically verify whether a key is attached to a paid project.
GEMINI_API_KEY=

# Set true ONLY AFTER independently confirming the project is on Free Tier,
# with no Cloud Billing account linked. No AI calls until explicitly enabled.
GEMINI_FREE_TIER_CONFIRMED=false
